{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextBoot",
  "version": "0.1.0",
  "identifier": "com.nextboot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NextBoot - 多系统重启切换",
        "width": 780,
        "height": 660,
        "minWidth": 640,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    },
    "linux": {
      "deb": {
        "section": "admin",
        "desktopTemplate": null,
        "files": {
          "/usr/bin/nextboot-cli": "../target/release/nextboot-cli"
        }
      }
    }
  }
}
